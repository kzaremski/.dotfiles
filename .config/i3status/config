# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        interval = 1
}

#order += "ipv6"
order += "wireless _first_"
order += "eth_cycle"
order += "battery_cycle"
order += "disk /"
#order += "load"
order += "cpu_cycle"
order += "memory"
order += "tztime local"

wireless _first_ {
        format_down = "NO WLAN"
#        format_up = "WLAN: (%quality @ %essid) %ip"
	format_up = "WLAN %ip"
}

# eth_cycle module configuration (py3status custom module)
eth_cycle {
        interface = "_first_"
        cycle_interval = 2
        format_ip = "LAN {ip}"
        format_speed = "LAN {speed}"
        format_down = "NO LAN"
}

# battery_cycle module configuration (py3status custom module)
battery_cycle {
        cycle_interval = 2
        format_percent = "BAT {percent}%"
        format_time = "BAT {time}"
        format_charging = "CHG {percent}%"
        format_full = "FULL"
        good_threshold = 70
        degraded_threshold = 30
}

disk "/" {
        format = "SSD %avail FREE"
}

load {
        format = "%1min"
}

# cpu_cycle module configuration (py3status custom module)
cpu_cycle {
	cycle_interval = 2
	temp_path = "/sys/class/hwmon/hwmon4/temp1_input"
	format_usage = "CPU {usage}%"
	format_temp = "CPU {temp}°C"
	degraded_threshold = 75
	max_threshold = 90
}

memory {
        format = "RAM %used/%total"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%Y-%m-%d %H:%M:%S"
}

