#!/bin/bash
# Launch DaVinci Resolve with DisplayScale matching the CURRENT monitor.
#
# Resolve ignores QT_SCALE_FACTOR. Its UI scaling lives in config.user.xml as
# <DisplayScale>, which is a single global value -- there is no per-monitor
# setting and no command-line override. 200 is right for the built-in 2560x1600
# panel and twice too big on the 1920x1080 dock monitors, so a value baked in
# while undocked makes Resolve launch zoomed-in while docked, and vice versa.
#
# So: read the focused monitor's scale at launch and rewrite the tag to match.
#
# Limitation: fixed at launch, like keepassxc-scaled. Docking or dragging the
# window to a differently-scaled monitor mid-session will not update it --
# quit and relaunch.

CONFIG="$HOME/.local/share/DaVinciResolve/configs/config.user.xml"

scale=$(hyprctl monitors -j 2>/dev/null | python3 -c '
import json,sys
try:
    mons = json.load(sys.stdin)
except Exception:
    print(1); raise SystemExit
for m in mons:
    if m.get("focused"):
        print(m.get("scale") or 1); raise SystemExit
print(mons[0].get("scale") if mons else 1)
' 2>/dev/null)

case "$scale" in
  ''|*[!0-9.]*) scale=1 ;;
esac

# Resolve is already running: it owns the config and rewrites it on exit, so
# editing now would just be clobbered. Launch and let it raise the window.
if [ -f "$CONFIG" ] && ! pgrep -x resolve >/dev/null 2>&1; then
  python3 - "$CONFIG" "$scale" <<'PY'
import re, sys
path, scale = sys.argv[1], float(sys.argv[2])
# Resolve accepts discrete percentages; round to the nearest 25 and clamp.
want = int(max(100, min(300, round(scale * 100 / 25) * 25)))
try:
    s = open(path, encoding="utf-8").read()
except Exception:
    raise SystemExit(0)
new, n = re.subn(r"(<DisplayScale>)\s*\d+\s*(</DisplayScale>)",
                 r"\g<1>%d\g<2>" % want, s, count=1)
if n and new != s:
    open(path, "w", encoding="utf-8").write(new)
PY
fi

exec /opt/resolve/bin/resolve "$@"
