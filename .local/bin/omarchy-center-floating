#!/bin/bash
# Centre every floating window on the current workspace.
#
# Floating windows hold absolute pixel coordinates, so when a monitor is
# unplugged or the layout shifts, a window can end up parked entirely in
# negative space: still listed by `hyprctl clients`, still focusable by
# keyboard, but impossible to reach with the mouse and invisible on every
# screen. Centring drags them back onto their monitor without disturbing
# their size or float state.
#
#   omarchy-center-floating             current workspace only
#   omarchy-center-floating --all       every workspace, including hidden ones
#   omarchy-center-floating --notify    also raise a desktop notification
#
# --notify exists so callers do not have to wrap this in `sh -c "... && notify"`.
# o.notify() single-quotes its message, and nesting that inside a single-quoted
# sh -c silently truncates it to the first word.
#
# Fullscreen windows are skipped: Hyprland's centre dispatcher only acts on
# floating windows and reports "No floating window found" for them.
set -uo pipefail

scope=current
notify=no
for arg in "$@"; do
  case "$arg" in
    --all|-a)    scope=all ;;
    --notify|-n) notify=yes ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

announce() {
  [ "$notify" = yes ] || return 0
  command -v omarchy-notification-send >/dev/null || return 0
  omarchy-notification-send -u low "$1"
}

mapfile -t rows < <(
  ALL="$scope" python3 - <<'PY'
import json, os, subprocess

def hypr(*args):
    out = subprocess.run(["hyprctl", *args, "-j"], capture_output=True, text=True).stdout
    return json.loads(out) if out.strip() else None

everywhere = os.environ.get("ALL") == "all"
active = hypr("activeworkspace")
ws_id = active["id"] if active else None

for c in hypr("clients") or []:
    if not c.get("floating"):
        continue
    if not everywhere and c["workspace"]["id"] != ws_id:
        continue
    state = "fullscreen" if c.get("fullscreen") else "ok"
    print("\t".join((c["address"], state, c["class"] or "?", c["workspace"]["name"])))
PY
)

if [ ${#rows[@]} -eq 0 ]; then
  echo "no floating windows to centre"
  announce "No floating windows to centre"
  exit 0
fi

centred=0 skipped=0
for row in "${rows[@]}"; do
  IFS=$'\t' read -r addr state cls ws <<<"$row"
  if [ "$state" = fullscreen ]; then
    echo "  skipped $cls (ws $ws) -- fullscreen"
    skipped=$((skipped + 1))
    continue
  fi
  if hyprctl dispatch "hl.dsp.window.center({ window = \"address:$addr\" })" >/dev/null 2>&1; then
    echo "  centred $cls (ws $ws)"
    centred=$((centred + 1))
  else
    echo "  FAILED  $cls (ws $ws)"
    skipped=$((skipped + 1))
  fi
done

echo "centred $centred, skipped $skipped"

if [ "$centred" -eq 0 ]; then
  announce "Nothing to centre (skipped $skipped)"
elif [ "$skipped" -gt 0 ]; then
  announce "Centred $centred, skipped $skipped"
else
  announce "Centred $centred floating window(s)"
fi
