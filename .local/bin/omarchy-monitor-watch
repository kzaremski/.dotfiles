#!/bin/bash
# Re-apply the display rules whenever a monitor appears or vanishes.
#
# monitors.lua decides how to split the workspaces by checking which VE248
# serials are attached: both panels get 1-5 / 6-10, a lone panel gets all ten.
# Hyprland only evaluates that at config load, though, so when this dock drops
# a panel mid-session -- which it does as it heats up -- workspaces stay pinned
# to a monitor that is gone. They still answer SUPER+6..0 and still hold their
# windows, but no attached output displays them.
#
# Listening for hotplug events and reloading re-runs that decision, so the
# surviving panel picks up all ten workspaces on its own.
#
# Two things keep this from thrashing:
#
#   * Debounce. The dock flaps rather than failing cleanly -- the Hyprland log
#     shows DP-6 and DP-9 being rechecked over and over during one unplug -- so
#     events are coalesced and the reload happens once the stream goes quiet.
#
#   * Change detection. After the quiet period the current set of outputs is
#     compared with the last one acted on, so a flap that ends where it started
#     costs nothing. A reload re-applies every rule in the config, so it is not
#     something to do on every twitch.
set -uo pipefail

debounce="${OMARCHY_MONITOR_DEBOUNCE:-3}"
sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock"

[ -S "$sock" ] || { echo "no Hyprland event socket at $sock" >&2; exit 1; }
command -v socat >/dev/null || { echo "socat is required" >&2; exit 1; }

# Only one watcher per Hyprland instance. Without this, a second one would
# double every reload.
lock="${XDG_RUNTIME_DIR:-/tmp}/omarchy-monitor-watch.lock"
exec 9>"$lock"
flock -n 9 || { echo "another watcher already holds $lock" >&2; exit 0; }

outputs() {
  hyprctl monitors 2>/dev/null | awk '/^Monitor /{print $2}' | sort | paste -sd,
}

# A reload issues modesets. That is exactly what must NOT be done repeatedly
# while a link is flapping: on 2026-09-27 this dock produced 103 HPD
# interrupts in five minutes, the display microcontroller stopped answering
# ("amdgpu [drm] *ERROR* wait_for_completion_timeout"), the Thunderbolt tunnel
# collapsed and the machine had to be held down at the power button. The
# hardware caused that, not this script -- but poking a sick display engine
# cannot help, so the guards below keep it quiet exactly when things look bad.
min_interval="${OMARCHY_MONITOR_MIN_INTERVAL:-30}"
storm_events="${OMARCHY_MONITOR_STORM_EVENTS:-12}"
storm_window="${OMARCHY_MONITOR_STORM_WINDOW:-60}"
storm_cooldown="${OMARCHY_MONITOR_STORM_COOLDOWN:-300}"

last=$(outputs)
pending=0
last_reload=0
window_start=$(date +%s)
window_count=0
cooldown_until=0
warned=0

while :; do
  IFS= read -r -t "$debounce" line
  rc=$?

  if [ $rc -eq 0 ]; then
    case "$line" in
      monitoradded*|monitorremoved*)
        pending=1
        now=$(date +%s)
        if [ $((now - window_start)) -gt "$storm_window" ]; then
          window_start=$now
          window_count=0
        fi
        window_count=$((window_count + 1))
        if [ "$window_count" -gt "$storm_events" ] && [ "$now" -ge "$cooldown_until" ]; then
          cooldown_until=$((now + storm_cooldown))
          echo "hotplug storm ($window_count events in ${storm_window}s) -- backing off ${storm_cooldown}s" >&2
          if [ "$warned" -eq 0 ] && command -v omarchy-notification-send >/dev/null; then
            omarchy-notification-send -u critical \
              "Display link is flapping -- not touching it. Check the dock cable."
            warned=1
          fi
        fi
        ;;
    esac
    continue
  fi

  # read(1) returns >128 on timeout and 1 on EOF; only the timeout means the
  # event stream simply went quiet. EOF means socat died or Hyprland exited.
  if [ $rc -le 128 ]; then
    echo "event stream closed" >&2
    exit 0
  fi

  [ "$pending" -eq 1 ] || continue
  pending=0

  now=$(date +%s)

  # A flapping link is not a layout change worth chasing. Wait it out.
  [ "$now" -lt "$cooldown_until" ] && continue

  # Never modeset more often than this, however the events arrive.
  [ $((now - last_reload)) -lt "$min_interval" ] && continue

  now_outputs=$(outputs)
  [ "$now_outputs" = "$last" ] && continue

  last="$now_outputs"
  last_reload=$now
  warned=0

  # Reload first so monitors.lua re-decides the split for whatever is attached
  # now, then rehome. Both steps are needed and neither replaces the other:
  # reload re-reads the rules but Hyprland only applies them when a monitor
  # connects or a workspace is created, so workspaces that already exist stay
  # on a panel that just died. Rehoming moves those.
  hyprctl reload >/dev/null 2>&1
  omarchy-displays-rehome >/dev/null 2>&1

  command -v omarchy-notification-send >/dev/null &&
    omarchy-notification-send -u low "Displays changed -- workspaces rehomed"
done < <(socat -U - "UNIX-CONNECT:$sock")
