#!/bin/bash
# Share this machine's internet connection with another network adapter.
#
# NetworkManager's `ipv4.method shared` does the whole job: assigns an address,
# runs dnsmasq for DHCP and DNS, enables forwarding and installs the NAT rules.
# It NATs out whatever currently holds the default route, so the "source" is
# chosen for you -- you only pick what to share TO.
#
# Sharing to a wired port and sharing to Wi-Fi are different operations:
# wired uses a shared-method connection, Wi-Fi puts the radio into AP mode.
# A single Wi-Fi radio cannot be client and AP at once, so you cannot share
# Wi-Fi to Wi-Fi.
set -uo pipefail

PREFIX="omarchy-share"

die() { gum style --foreground 1 "  $*"; exit 1; }
note() { gum style --foreground 4 "  $*"; }

uplink() { ip route show default 2>/dev/null | awk '/^default/{print $5; exit}'; }

active_shares() {
  nmcli -t -f NAME,DEVICE con show --active 2>/dev/null \
    | awk -F: -v p="$PREFIX" '$1 ~ "^"p || $1=="Hotspot" {print $1"\t"$2}'
}

status() {
  local up; up=$(uplink)
  gum style --bold "  Network sharing"
  echo "    uplink (source): ${up:-none — no default route}"
  local rows; rows=$(active_shares)
  if [ -n "$rows" ]; then
    echo "    active shares:"
    printf '%s\n' "$rows" | while IFS=$'\t' read -r n d; do
      echo "      $n on ${d:-?}   $(ip -4 -br addr show "$d" 2>/dev/null | awk '{print $3}')"
    done
  else
    echo "    active shares: none"
  fi
}

# Candidate targets: anything that is not the uplink, not loopback, not a tunnel.
targets() {
  local up; up=$(uplink)
  nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | awk -F: -v up="$up" '
    $2!="loopback" && $2!="tun" && $2!="wifi-p2p" && $1!=up {
      printf "%s\t%s\t%s\n", $1, $2, $3 }'
}

share_wired() {
  local dev="$1" con="$PREFIX-$1"
  nmcli con delete "$con" >/dev/null 2>&1
  nmcli con add type ethernet ifname "$dev" con-name "$con" \
        ipv4.method shared ipv6.method ignore >/dev/null \
    || die "could not create the shared connection on $dev"
  nmcli con up "$con" >/dev/null || die "could not bring up $con"
  allow_firewall "$dev" "${2:-}"
  note "Sharing ${2:-internet} to $dev"
  ip -4 -br addr show "$dev" | sed 's/^/    /'
}

share_wifi() {
  local dev="$1" ssid pass
  ssid=$(gum input --header "Hotspot name (SSID)" --value "pocket" --width 40) || exit 0
  [ -n "$ssid" ] || die "no SSID given"
  pass=$(gum input --password --header "Password (8+ characters)" --width 40) || exit 0
  [ ${#pass} -ge 8 ] || die "password must be at least 8 characters"
  nmcli dev wifi hotspot ifname "$dev" ssid "$ssid" password "$pass" >/dev/null \
    || die "could not start the hotspot (is the radio already a client?)"
  allow_firewall "$dev"
  note "Hotspot '$ssid' up on $dev"
  ip -4 -br addr show "$dev" | sed 's/^/    /'
}

# UFW defaults to DROP for both inbound and routed traffic, and a share needs
# both allowed:
#   inbound -- or the clients' DHCP and DNS never reach dnsmasq, so they get
#              no address at all;
#   routed  -- or they get an address but no internet. NetworkManager installs
#              its own accept rules in an nm-shared-<dev> table, but nftables
#              runs *every* base chain registered on the forward hook and an
#              accept only ends the chain it is in, so ufw's `policy drop`
#              still discards packets nm-shared already accepted.
# Both rules go in under a single pkexec so this only asks for a password once.
allow_firewall() {
  local dev="$1" up="${2:-}"
  command -v ufw >/dev/null || return 0
  [ -n "$up" ] || up=$(uplink)
  pkexec /bin/bash -c '
    ufw allow in on "$1" >/dev/null 2>&1 || exit 1
    [ -n "$2" ] || exit 3
    ufw route allow in on "$1" out on "$2" >/dev/null 2>&1 || exit 2
  ' _ "$dev" "$up"
  case $? in
    0) note "ufw: inbound on $dev, routing $dev -> $up" ;;
    1) note "ufw: could not allow inbound on $dev (clients may not get DHCP)" ;;
    2) note "ufw: could not allow routing (clients get an address but no internet)" ;;
    3) note "ufw: no uplink to route to -- allowed inbound on $dev only" ;;
    *) note "ufw: rules were not applied" ;;
  esac
}

# Drop both rules again. The route rule embeds the uplink, which may have
# changed since the share was started, so find it by device rather than
# reconstructing the original rule. Delete by index, highest first, because
# the numbers shift as each rule goes.
deny_firewall() {
  local dev="$1"
  command -v ufw >/dev/null || return 0
  pkexec /bin/bash -c '
    dev=$1
    ufw delete allow in on "$dev" >/dev/null 2>&1
    while :; do
      n=$(ufw status numbered 2>/dev/null \
          | grep "ALLOW FWD" \
          | grep -E "on ${dev}[[:space:]]*$" \
          | sed -nE "s/^[[:space:]]*\\[[[:space:]]*([0-9]+)\\].*/\\1/p" \
          | sort -rn | head -1)
      [ -n "$n" ] || break
      ufw --force delete "$n" >/dev/null 2>&1 || break
    done
  ' _ "$dev"
}

stop_sharing() {
  local rows; rows=$(active_shares)
  [ -n "$rows" ] || { note "nothing is being shared"; return; }
  printf '%s\n' "$rows" | while IFS=$'\t' read -r n d; do
    nmcli con down "$n" >/dev/null 2>&1
    [[ $n == "$PREFIX"* ]] && nmcli con delete "$n" >/dev/null 2>&1
    [ -n "$d" ] && deny_firewall "$d"
    note "stopped $n${d:+ on $d}"
  done
}

main() {
  command -v gum >/dev/null || die "gum is required"
  local up; up=$(uplink)

  local choice
  choice=$(printf '%s\n' \
    "Share to an adapter" "Stop sharing" "Status" \
    | gum choose --header "Network sharing   (uplink: ${up:-none})") || exit 0

  case "$choice" in
    Status) status ;;
    "Stop sharing") stop_sharing ;;
    "Share to an adapter")
      [ -n "$up" ] || die "no default route -- nothing to share"
      local rows; rows=$(targets)
      [ -n "$rows" ] || die "no adapters available to share to"
      local pick dev type
      pick=$(printf '%s\n' "$rows" | awk -F'\t' '{printf "%s  (%s, %s)\n",$1,$2,$3}' \
        | gum choose --header "Share $up to which adapter?") || exit 0
      dev=${pick%% *}
      type=$(printf '%s\n' "$rows" | awk -F'\t' -v d="$dev" '$1==d{print $2}')
      case "$type" in
        wifi)     share_wifi "$dev" ;;
        ethernet) share_wired "$dev" "$up" ;;
        *)        share_wired "$dev" "$up" ;;
      esac
      ;;
  esac
  echo
  read -rsn1 -p "  Press any key..."
}

case "${1:-}" in
  status) status ;;
  stop)   stop_sharing ;;
  *)      main ;;
esac
