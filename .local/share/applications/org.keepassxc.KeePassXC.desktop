# --- LOCAL OVERRIDE -------------------------------------------------------
# Pinned to XWayland (QT_QPA_PLATFORM=xcb) deliberately.
#
# Running KeePassXC as a native Wayland client hits two open Hyprland bugs
# that make it unusable when tiled:
#   - hyprwm/Hyprland#9277 - clicks land at the wrong surface position after
#     a resize, so the window stops responding to clicks
#   - hyprwm/Hyprland#3167 - Qt clients cannot reset their window size
# Tiling causes a resize, so both fire immediately. Observed 2026-09-22.
#
# XWayland also restores global Auto-Type, which Wayland blocks outright
# (Auto-Type works by injecting input via XTEST).
#
# QT_SCALE_FACTOR=2 is required: Omarchy sets xwayland:force_zero_scaling =
# true, so XWayland clients render at 1x with no compositor upscaling, which
# is microscopic on this 2560x1600 / ~340 DPI panel.
#
# SECURITY TRADEOFF, accepted knowingly: X11 has no isolation between X
# clients. Any OTHER XWayland client can keylog globally, screenshot other X
# windows, and inject input. On this machine that means Steam and DaVinci
# Resolve (both proprietary) share an X server with the password manager.
# Wayland-native clients remain isolated from all of this.
# Note the clipboard is bridged between Wayland and XWayland either way, so
# KeePassXC's clipboard-clear timeout matters regardless of backend.
# --------------------------------------------------------------------------
Exec=keepassxc-scaled %f
TryExec=keepassxc
Icon=keepassxc
StartupWMClass=keepassxc
StartupNotify=false
Terminal=false
Type=Application
Version=1.5
Categories=Utility;Security;Qt;
MimeType=application/x-keepass2;
SingleMainWindow=true
X-GNOME-SingleWindow=true
Keywords=security;privacy;password-manager;yubikey;password;keepass;
Keywords[de]=sicherheit;privatsphäre;passwort-manager;yubikey;passwort;keepass;
